# Entorno virtual
.venv/
venv/
env/

# Python
__pycache__/
*.pyc
*.pyo
*.egg-info/
build/
dist/
.pytest_cache/

# Configuración con secretos/local (usar .env.example como plantilla)
.env
config/credentials.yaml
# Cada instalación registra sus propios proyectos (rutas locales): se versiona solo el ejemplo
config/config.yaml

# Generado por el sistema: índice vectorial y documentación por proyecto
# (docs/ generada por proyecto vive bajo data/<project_id>/docs/, ya cubierta abajo)
data/

# Frontend (Vite/React)
frontend/node_modules/
frontend/*.tsbuildinfo

# Sistema operativo
.DS_Store
Thumbs.db

# Editor
.vscode/
.idea/

# Claude Code: permisos/config local de sesión, no del proyecto
.claude/settings.local.json

# Notas personales del autor, no propósito general del repo
/DEFENSA.md

# Centro de memoria para retomar el proyecto con cualquier IA — contexto
# interno de desarrollo, no documentación pública. El nombre real en disco
# es minúscula (context.md); se ignoran ambos casos para no depender de
# que git corra en modo case-insensitive (default en Windows/Mac, no en Linux).
/CONTEXT.md
/context.md

# Entregables personales (informes para el profe, etc.), no documentación pública del repo
*.docx

# Documentación de la carrera (INACAP: marco teórico, historias de usuario,
# diagramas UML de la memoria) — es material de la asignatura/defensa, no
# documentación del software en sí (eso vive en docs/ARQUITECTURA.md y README.md)
/marco-teorico-beacon-v2.md
/requerimientos_historias_usuario.md
/resumen_notebooklm_beacon.md
/diagramas-drawio/
/Beacon_Cronograma.xml
/gantt.png
/Beacon_ES1_Respuesta_a_comentarios.docx
