# Entorno virtual
.venv/
venv/
env/

# Python
__pycache__/
*.pyc
*.pyo
*.egg-info/
build/
dist/
.pytest_cache/

# Configuración con secretos/local (usar .env.example como plantilla)
.env
config/credentials.yaml
# Cada instalación registra sus propios proyectos (rutas locales): se versiona solo el ejemplo
config/config.yaml

# Generado por el sistema: índice vectorial y documentación por proyecto
# (docs/ generada por proyecto vive bajo data/<project_id>/docs/, ya cubierta abajo)
data/

# Frontend (Vite/React)
frontend/node_modules/
frontend/*.tsbuildinfo

# Sistema operativo
.DS_Store
Thumbs.db

# Editor
.vscode/
.idea/

# Pruebas y cobertura
.coverage

# Configuración local de Claude Code
.claude/

# Material personal del equipo (informes, defensa, notas, diagramas, guías):
# no es parte del software y no se publica
/privado/
*.docx
